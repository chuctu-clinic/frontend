# Chép thành .env rồi sửa. Mọi biến đều có giá trị mặc định, để trống hoặc bỏ đi cũng chạy được.

# ---------- Khi phát triển (npm run dev) ----------
# Cổng của Vite
DEV_PORT=5173
# Backend mà Vite chuyển /api tới
DEV_API_TARGET=http://localhost:4000

# ---------- Khi build (npm run build, docker compose build) ----------
# Địa chỉ API khi frontend và backend ở hai địa chỉ khác nhau, ví dụ https://api.chuctu.vn.
# Để trống thì gọi /api cùng địa chỉ (khuyên dùng). Giá trị này được ghi vào mã của trình duyệt, không đặt bí mật ở đây.
VITE_API_URL=

# ---------- Khi chạy container (docker compose up) ----------
# Backend mà nginx chuyển /api tới
API_UPSTREAM=http://host.docker.internal:4000
